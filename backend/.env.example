# Conexión directa Neon: reservar para Alembic y migraciones.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Conexión Neon con pooler: la usa la aplicación FastAPI.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-POOLER/DATABASE?sslmode=require

# Clave local de ejemplo: reemplazar por un valor aleatorio fuera del repositorio.
JWT_SECRET_KEY=replace-with-a-random-secret-before-running-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcionales para ejecutar `python -m scripts.seed_users`; reemplaza cada valor.
SEED_ADMIN_PASSWORD=
SEED_SELLER_PASSWORD=
SEED_POSTOR_PASSWORD=
SCHEDULER_ENABLED=true
CORS_ORIGINS=http://localhost:4200
